# sling-server systemd service unit.
# Install:
#   sudo cp deploy/sling-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now sling-server
# Browse at http://<host-ip>:5666 (configure --token and firewall rules for
# remote access).

[Unit]
Description=sling-server Data Migration Workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust the run user and listen address as needed; always enable --token
# for remote access.
ExecStart=/usr/local/bin/sling-server --port 5666 --no-open
Restart=on-failure
RestartSec=5
# Data directory (credential vault / jobs / history)
Environment=SLING_HOME_DIR=/var/lib/sling
StateDirectory=sling
User=sling
Group=sling
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sling

[Install]
WantedBy=multi-user.target
