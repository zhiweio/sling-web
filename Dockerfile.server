# syntax=docker/dockerfile:1
# sling-server Data Migration Workbench — multi-stage build producing a
# lightweight, non-root runtime image.
#
#   docker build -f Dockerfile.server -t sling-server .
#   docker run -p 5666:5666 -v sling-data:/var/lib/sling sling-server
#
# Or simply: docker compose up -d --build   (see compose.yaml)
# Optional Oracle SQL*Loader support: set WITH_ORACLE=true (build arg,
# e.g. in .env) to bake in the Oracle Instant Client.

# ---- 1/3 · frontend: build the React SPA embedded via go:embed ----
FROM node:22-slim AS frontend
WORKDIR /app/web
COPY web/package.json web/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    corepack enable && pnpm install --frozen-lockfile
COPY web/ ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm run build

# ---- 2/3 · backend: compile the single binary (CGO for SQLite) ----
FROM golang:1.26-bookworm AS backend
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . ./
# host-built dist is .dockerignore'd; always take the one built above
COPY --from=frontend /app/web/dist ./web/dist
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 go build -p 1 -trimpath -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/sling-server ./cmd/sling-server

# ---- 3/3 · runtime ----
FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 sling \
 && useradd --system --uid 10001 --gid sling --home-dir /var/lib/sling sling \
 && mkdir -p /var/lib/sling && chown sling:sling /var/lib/sling
COPY --from=backend --chown=10001:10001 /out/sling-server /usr/local/bin/sling-server

# ---- optional: Oracle SQL*Loader for bulk writes ----
# sling prefers sqlldr (Oracle Instant Client "Tools" package) as the Oracle
# bulk-write fast path and silently falls back to pure-Go array DML when the
# binary is absent (core/dbio/database/database_oracle.go). Per Oracle's
# utilities guide (B.3–B.5), Tools must be unpacked into the same directory
# as the matching-version Basic/Light OCI package, which is put on PATH and
# LD_LIBRARY_PATH; no ORACLE_HOME is needed.
# Enable at build time: WITH_ORACLE=true via .env / --build-arg (adds ~80MB;
# Basic Light = English-only messages, UTF-8 and common charsets supported).
# Version bumps: ORACLE_IC_VERSION drives the download directory too
# (19.25.0.0.0dbru -> instantclient/1925000).
ARG TARGETARCH
ARG WITH_ORACLE=false
ARG ORACLE_IC_VERSION=19.25.0.0.0dbru
RUN if [ "$WITH_ORACLE" = "true" ]; then \
      case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
        amd64) ic_arch=x64 ;; \
        arm64) ic_arch=arm64 ;; \
        *) echo "WITH_ORACLE=true: unsupported architecture ${TARGETARCH}" >&2; exit 1 ;; \
      esac \
      && ic_major="${ORACLE_IC_VERSION%%.*}" \
      && ic_minor="${ORACLE_IC_VERSION#*.}" \
      && ic_minor="${ic_minor%%.*}" \
      && ic_dir="$(printf '%-7s' "${ic_major}${ic_minor}" | tr ' ' 0)" \
      && ic_base="https://download.oracle.com/otn_software/linux/instantclient/${ic_dir}" \
      && apt-get update \
      && apt-get install -y --no-install-recommends unzip libaio1 \
      && mkdir -p /opt/oracle \
      && curl -fsSL -o /tmp/ic-basic.zip "${ic_base}/instantclient-basiclite-linux.${ic_arch}-${ORACLE_IC_VERSION}.zip" \
      && curl -fsSL -o /tmp/ic-tools.zip "${ic_base}/instantclient-tools-linux.${ic_arch}-${ORACLE_IC_VERSION}.zip" \
      && unzip -oq /tmp/ic-basic.zip -d /opt/oracle \
      && unzip -oq /tmp/ic-tools.zip -d /opt/oracle \
      && rm -f /tmp/ic-basic.zip /tmp/ic-tools.zip \
      && mv /opt/oracle/instantclient_* /opt/oracle/instantclient \
      && echo /opt/oracle/instantclient > /etc/ld.so.conf.d/oracle-instantclient.conf \
      && ldconfig \
      && apt-get purge -y --auto-remove unzip \
      && rm -rf /var/lib/apt/lists/* \
      && ! ldd /opt/oracle/instantclient/sqlldr | grep -q "not found"; \
    fi

# SQL*Loader runtime config (utilities guide B.5): client dir on PATH +
# LD_LIBRARY_PATH, UTF-8 NLS. Harmless no-ops when WITH_ORACLE=false (the
# directory simply doesn't exist).
ENV PATH="/opt/oracle/instantclient:${PATH}" \
    LD_LIBRARY_PATH="/opt/oracle/instantclient" \
    NLS_LANG="AMERICAN_AMERICA.UTF8"

# container defaults: bind 0.0.0.0 (127.0.0.1 would be unreachable behind
# port mapping), keep all state on the mounted volume, and spill engine
# temp files (sqlldr data/ctl files) to disk — /tmp is a tmpfs in the
# hardened compose setup, RAM-backed, unsuitable for large loads
ENV SLING_HOME_DIR=/var/lib/sling \
    SLING_SERVER_HOST=0.0.0.0 \
    SLING_TEMP_DIR=/var/lib/sling/tmp
RUN mkdir -p /var/lib/sling/tmp && chown sling:sling /var/lib/sling/tmp
USER sling
WORKDIR /var/lib/sling
EXPOSE 5666
STOPSIGNAL SIGTERM
VOLUME /var/lib/sling
# /api/health sits behind the optional token auth, so send the token when set
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS -H "Authorization: Bearer $SLING_SERVER_TOKEN" \
    http://127.0.0.1:5666/api/health || exit 1
ENTRYPOINT ["/usr/local/bin/sling-server"]
CMD ["--port", "5666", "--no-open"]
