# sling-server Data Migration Workbench — multi-stage build producing a
# lightweight runtime image.
# docker build -t sling-server .
# docker run -p 5666:5666 -v sling-data:/root/.sling sling-server
FROM node:22-slim AS frontend
WORKDIR /app/web
COPY web/package.json web/pnpm-lock.yaml* ./
RUN corepack enable && (pnpm install --frozen-lockfile || pnpm install)
COPY web/ .
RUN pnpm run build

FROM golang:1.26-bookworm AS backend
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /app/web/dist ./web/dist
ARG VERSION=dev
RUN CGO_ENABLED=1 go build -p 1 -ldflags="-s -w -X main.version=${VERSION}" \
      -o /out/sling-server ./cmd/sling-server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*
COPY --from=backend /out/sling-server /usr/local/bin/sling-server
ENV SLING_HOME_DIR=/root/.sling
VOLUME /root/.sling
EXPOSE 5666
ENTRYPOINT ["sling-server"]
CMD ["--port", "5666", "--no-open"]
